<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.3.1</Version>
    <!-- The AutomationML Editor lists the packages on nuget.org that carry the tag
         AMLEditorPlugin.Net (PlugIn Manager, PublicSource); CI refuses a package without it. -->
    <PackageId>Aml.Editor.Plugin.OpcUa</PackageId>
    <Title>AMLOpcUa</Title>
    <Description>OPC UA for the AutomationML Editor. Imports OPC UA NodeSets as AML libraries according to OPC 10000-83 Annex A, creates and checks instances of UA types, and exports AML documents as NodeSets. Connects to OPC UA servers: imports their types, takes their nodes into the document and keeps values live; serves a document as an OPC UA server. Brings a practice plant (the MPS 500 learning factory, served on this computer), diagrams in OPC 10000-3 notation and the graphical modeler NodeSet.js. English and German.</Description>
    <PackageTags>AMLEditor; AMLEditorPlugin.Net; AutomationML; OPCUA; OPC-UA; NodeSet; UAFX; Opc2Aml</PackageTags>
    <Authors>Hamied Nabizada</Authors>
    <Copyright>Copyright (c) 2026 Hamied Nabizada and contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hsu-aut/AMLOpcUa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hsu-aut/AMLOpcUa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The page of the package on nuget.org; with absolute links, which the repository README lacks. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Anchored at this file so a build of the project alone lands in the same tree. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\Plugins\$(MSBuildProjectName)</BaseOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aml.Editor.Plugin.OpcUa.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor-side dependencies, pinned exactly: a drift changes the surface
         this plugin compiles against without any error. -->
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="[4.3.0]">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <!-- Provided by the editor at run time: not copied (ExcludeAssets) and not
         declared as dependencies of the package (PrivateAssets). Declared, the
         PlugIn Manager downloads them from nuget.org next to the plugin, and
         without a network the installation fails.
         Aml.Engine: a range without a wildcard builds against its lowest
         version, the one tested. With "4.*" each build took the newest one on
         nuget.org and needed an editor at least as new. -->
    <PackageReference Include="Aml.Engine" Version="[4.5.2, 5.0.0)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Aml.Editor.API" Version="[2.3.0]">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Aml.Skins" Version="2.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Hosts the graphical modeler (NodeSet.js). Bundled with the plugin
         like the other runtime dependencies, not a NuGet dependency. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The modeler's web build, served to WebView2 from the plugin folder. -->
  <PropertyGroup>
    <NodeSetDist>$(MSBuildThisFileDirectory)..\..\NodeSet.js\dist\web</NodeSetDist>
  </PropertyGroup>
  <ItemGroup Condition="'$(SkipModeler)' != 'true'">
    <None Include="$(NodeSetDist)\**\*"
          Link="modeler-assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)\modeler-assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- WebView2Loader.dll is a native file of the WebView2 package. NuGet.Pack
       drops items that point into runtimes/<rid>/native, so a copy is staged
       under obj/ and packed from there, next to the plugin's assemblies. -->
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)bundled\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)\WebView2Loader.dll" />
  </ItemGroup>
  <Target Name="StageWebView2Loader" BeforeTargets="BeforeResolveReferences">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(IntermediateOutputPath)bundled\"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- A build without the modeler is for checking the C# alone (CI); the
       plugin it produces has no Modeler tab content, so it is not shipped. -->
  <Target Name="VerifyNodeSetDist" BeforeTargets="BeforeBuild" Condition="'$(SkipModeler)' != 'true'">
    <Error Condition="!Exists('$(NodeSetDist)\index.html')"
           Text="The modeler is not built. Run 'npm install' and 'npm run build' in $(NodeSetDist)\..\.., or build with -p:SkipModeler=true to leave it out." />
  </Target>
  <Target Name="WarnWithoutModeler" BeforeTargets="BeforeBuild" Condition="'$(SkipModeler)' == 'true'">
    <Warning Text="Built without the modeler (SkipModeler=true): the Modeler tab has nothing to show." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\dotnet\OpcUaAml.Core\OpcUaAml.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- The converter: the command line tool, run in a process of its own
       (ConverterProcess.cs). It lives in a folder of its own with its own
       Aml.Engine, which the plugin's load context never sees. -->
  <ItemGroup>
    <ProjectReference Include="..\dotnet\OpcUaAml.Tool\OpcUaAml.Tool.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <ConverterBuild>$(MSBuildThisFileDirectory)..\dotnet\OpcUaAml.Tool\bin\$(Configuration)\net8.0\</ConverterBuild>
  </PropertyGroup>
  <Target Name="CollectConverter">
    <Error Condition="!Exists('$(ConverterBuild)uaaml.exe')" Text="The converter was not built: $(ConverterBuild)uaaml.exe is missing." />
    <ItemGroup>
      <_Converter Include="$(ConverterBuild)**\*" Exclude="$(ConverterBuild)**\*.pdb;$(ConverterBuild)README.md">
        <Sub>%(RecursiveDir)</Sub>
      </_Converter>
    </ItemGroup>
  </Target>
  <Target Name="CopyConverter" AfterTargets="Build" DependsOnTargets="CollectConverter">
    <RemoveDir Directories="$(OutDir)converter" />
    <Copy SourceFiles="@(_Converter)" DestinationFiles="@(_Converter->'$(OutDir)converter\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <None Include="Metadata.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The practice plant: the MPS 500, served from the Server tab. -->
    <None Include="..\examples\mps500\MPS500.NodeSet2.xml" Link="examples\MPS500.NodeSet2.xml" CopyToOutputDirectory="PreserveNewest"
          Pack="true" PackagePath="lib\$(TargetFramework)\examples\" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>

  <!--
    Everything the core needs at run time is bundled: the core itself, Opc2Aml,
    the OPC UA stack and its dependencies, and the bundled NodeSets. The list
    comes from the resolved references, not from the output folder, so a file
    left over from an earlier build cannot slip into the package. What the
    editor already loads is left out on purpose: a second copy of the contract
    or of Aml.Engine in the plugin folder is loaded into the plugin's own load
    context, and the plugin then no longer matches the editor's interfaces.
    That includes Aml.Engine.Services (the CAEX 2.15 to 3.0 conversion), which
    the editor uses for its own conversion; without it only that button fails.
  -->
  <Target Name="PackRuntimeDependencies" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build;CollectConverter">
    <ItemGroup>
      <_Bundled Include="@(ReferenceCopyLocalPaths)"
                Condition="'%(Extension)' == '.dll'
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Aml.Engine'))
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Aml.Editor.'))
                           And '%(Filename)' != 'Aml.Skins'
                           And '%(Filename)' != 'Octokit'
                           And '%(Filename)' != 'Aml.Toolkit'
                           And '%(Filename)' != 'ControlzEx'
                           And !$([System.String]::Copy('%(Filename)').StartsWith('MahApps.'))
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Xaml.Behaviors'))" />
      <_BundledNodeSets Include="..\nodesets\*.xml" />
      <None Include="@(_Bundled)" Pack="true" PackagePath="lib\$(TargetFramework)\" />
      <None Include="@(_BundledNodeSets)" Pack="true" PackagePath="lib\$(TargetFramework)\nodesets\" />
      <_ConverterPacked Include="@(_Converter)" PackagePath="lib\$(TargetFramework)\converter\%(_Converter.Sub)" />
      <None Include="@(_ConverterPacked)" Pack="true" />
    </ItemGroup>
  </Target>

</Project>
