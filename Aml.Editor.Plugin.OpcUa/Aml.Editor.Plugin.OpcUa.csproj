<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.1.0</Version>
    <Title>AMLOpcUa</Title>
    <Description>AutomationML Editor plugin for OPC UA: imports NodeSets as AML libraries according to OPC 10000-83 Annex A.</Description>
    <PackageTags>AMLEditor; AMLEditorPlugin.Net; AutomationML; OPCUA; NodeSet; UAFX</PackageTags>
    <Authors>Hamied Nabizada</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Anchored at this file so a build of the project alone lands in the same tree. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\Plugins\$(MSBuildProjectName)</BaseOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Editor-side dependencies, pinned exactly: a drift changes the surface
         this plugin compiles against without any error. -->
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="[4.3.0]">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Aml.Engine" Version="[4.*, 5.0.0)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Aml.Editor.API" Version="[2.3.0]">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Aml.Skins" Version="2.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Hosts the graphical modeler (InfoModel.js). Bundled with the plugin
         like the other runtime dependencies, not a NuGet dependency. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The modeler's web build, served to WebView2 from the plugin folder. -->
  <PropertyGroup>
    <InfoModelDist>$(MSBuildThisFileDirectory)..\..\InfoModel.js\dist\web</InfoModelDist>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(InfoModelDist)\**\*"
          Link="infomodel-assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)\infomodel-assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- WebView2Loader.dll is a native file of the WebView2 package. NuGet.Pack
       drops items that point into runtimes/<rid>/native, so a copy is staged
       under obj/ and packed from there, next to the plugin's assemblies. -->
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)bundled\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)\WebView2Loader.dll" />
  </ItemGroup>
  <Target Name="StageWebView2Loader" BeforeTargets="BeforeResolveReferences">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(IntermediateOutputPath)bundled\"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="VerifyInfoModelDist" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(InfoModelDist)\index.html')"
           Text="The modeler is not built. Run 'npm install' and 'npm run build' in $(InfoModelDist)\..\.." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\dotnet\OpcUaAml.Core\OpcUaAml.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Metadata.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>

  <!--
    Everything the core needs at run time is bundled: the core itself, Opc2Aml,
    the OPC UA stack and its dependencies, and the bundled NodeSets. The list
    comes from the resolved references, not from the output folder, so a file
    left over from an earlier build cannot slip into the package. What the
    editor already loads is left out on purpose: a second copy of the contract
    or of Aml.Engine in the plugin folder is loaded into the plugin's own load
    context, and the plugin then no longer matches the editor's interfaces.
    That includes Aml.Engine.Services (the CAEX 2.15 to 3.0 conversion), which
    the editor uses for its own conversion; without it only that button fails.
  -->
  <Target Name="PackRuntimeDependencies" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <_Bundled Include="@(ReferenceCopyLocalPaths)"
                Condition="'%(Extension)' == '.dll'
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Aml.Engine'))
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Aml.Editor.'))
                           And '%(Filename)' != 'Aml.Skins'
                           And '%(Filename)' != 'Aml.Toolkit'
                           And '%(Filename)' != 'ControlzEx'
                           And !$([System.String]::Copy('%(Filename)').StartsWith('MahApps.'))
                           And !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Xaml.Behaviors'))" />
      <_BundledNodeSets Include="..\nodesets\*.xml" />
      <None Include="@(_Bundled)" Pack="true" PackagePath="lib\$(TargetFramework)\" />
      <None Include="@(_BundledNodeSets)" Pack="true" PackagePath="lib\$(TargetFramework)\nodesets\" />
    </ItemGroup>
  </Target>

</Project>
