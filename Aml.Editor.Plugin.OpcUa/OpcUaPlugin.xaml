<aml:PluginViewBase
    x:Class="Aml.Editor.Plugin.OpcUa.OpcUaPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:aml="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="800">

    <TabControl x:Name="Tabs">
        <TabItem Header="OPC UA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <ToolBar.Resources>
                        <Style x:Key="IconText" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </ToolBar.Resources>

                    <Button x:Name="ImportButton" Click="ImportButton_Click"
                            ToolTip="Import an OPC UA NodeSet (NodeSet2.xml) as AutomationML libraries according to OPC 10000-83 Annex A.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B5;" Foreground="#2070C0"/>
                            <TextBlock Text="Import NodeSet…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Click="ExportButton_Click"
                            ToolTip="Export this document as an OPC UA NodeSet by the rules of the AutomationML/OPC Foundation working group (AML-UA-XSLT, successor of OPC 30040).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEDE1;" Foreground="#2070C0"/>
                            <TextBlock Text="Export NodeSet..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloudButton" Click="CloudButton_Click"
                            ToolTip="Search the OPC Foundation's UA Cloud Library and import a model with the models it requires.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE753;" Foreground="#2070C0"/>
                            <TextBlock Text="Cloud Library…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FoldersButton" Click="FoldersButton_Click"
                            ToolTip="Folders searched for NodeSets that an import requires. The UA base model and DI are built in.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;"/>
                            <TextBlock Text="NodeSet folders…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <Button x:Name="InstanceButton" Click="InstanceButton_Click"
                            ToolTip="Create an instance of a UA type with its Mandatory children and the Optional children you choose.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" Foreground="#20A040"/>
                            <TextBlock Text="New instance…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckButton" Click="CheckButton_Click"
                            ToolTip="Check the instance hierarchies against their UA types (Mandatory children, placeholders, reference pairs).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" Foreground="#E08020"/>
                            <TextBlock Text="Check" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LinkButton" Click="LinkButton_Click"
                            ToolTip="Link a VDI 3682 TechnicalResource to the OPC UA object representing it, or a ProcessOperator to the method executing it.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" Foreground="#8040A0"/>
                            <TextBlock Text="Link VDI 3682..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <CheckBox x:Name="ReplaceToggle" Content="Replace existing" VerticalAlignment="Center"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTip="Replace OPC UA libraries the document already has. A newer model is never replaced by an older one."/>
                    <CheckBox x:Name="SaveToggle" Content="Save after import" VerticalAlignment="Center" Margin="8,0,0,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTip="Trigger the editor's save command after a successful import."/>
                </ToolBar>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="OPC UA namespaces in this document" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="Placeholder" DockPanel.Dock="Top" Margin="0,8" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Open a CAEX 3.0 document to import OPC UA NodeSets."/>
                        <ListView x:Name="NamespaceList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Namespace URI" Width="360" DisplayMemberBinding="{Binding NamespaceUri}"/>
                                    <GridViewColumn Header="Model version" Width="100" DisplayMemberBinding="{Binding ModelVersion}"/>
                                    <GridViewColumn Header="Published" Width="100" DisplayMemberBinding="{Binding Published}"/>
                                    <GridViewColumn Header="Libraries" Width="70" DisplayMemberBinding="{Binding LibraryCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                    <DockPanel Grid.Row="2" Margin="4">
                        <DockPanel DockPanel.Dock="Top">
                            <CheckBox x:Name="DebugToggle" DockPanel.Dock="Right" Content="Debug log"
                                      Checked="DebugToggle_Changed" Unchecked="DebugToggle_Changed"/>
                            <TextBlock Text="Log" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogFilePathLabel" Margin="8,0" Foreground="Gray"/>
                        </DockPanel>
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Grid>

                <StatusBar Grid.Row="2">
                    <StatusBarItem>
                        <ProgressBar x:Name="Busy" Width="80" Height="12" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusText"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>
        <TabItem Header="Check" x:Name="CheckTab">
            <DockPanel Margin="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="UpgradeButton" DockPanel.Dock="Right" Content="Add missing Mandatory children" Click="UpgradeButton_Click"
                            ToolTip="After importing a newer version of a companion specification: add the Mandatory children the types now declare. Nothing existing is changed."/>
                    <TextBlock x:Name="CheckSummary" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Run Check to verify the instances against their UA types."/>
                </DockPanel>
                <ListView x:Name="FindingList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding Severity}"/>
                            <GridViewColumn Header="Rule" Width="60" DisplayMemberBinding="{Binding Rule}"/>
                            <GridViewColumn Header="Element" Width="260" DisplayMemberBinding="{Binding ElementPath}"/>
                            <GridViewColumn Header="Finding" Width="480" DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>
        <TabItem Header="Server" x:Name="ServerTab">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Endpoint" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect" Width="90" Click="ConnectButton_Click"/>
                    <CheckBox x:Name="SecurityToggle" DockPanel.Dock="Right" Content="Secure" VerticalAlignment="Center" Margin="8,0"
                              ToolTip="Prefer a signed and encrypted endpoint."/>
                    <PasswordBox x:Name="PasswordBox" DockPanel.Dock="Right" Width="100" ToolTip="Password (empty for anonymous)"/>
                    <TextBox x:Name="UserBox" DockPanel.Dock="Right" Width="100" Margin="8,0,4,0" ToolTip="User name (empty for anonymous)"/>
                    <TextBox x:Name="EndpointBox"/>
                </DockPanel>
                <ToolBar Grid.Row="1">
                    <Button x:Name="MirrorButton" Content="Take into document" Click="MirrorButton_Click"
                            ToolTip="Create elements for the selected node and the nodes below it, with their NodeIds, UA types and current values."/>
                    <TextBlock Text=" depth " VerticalAlignment="Center"/>
                    <TextBox x:Name="MirrorDepthBox" Text="3" Width="30"/>
                    <TextBlock Text=" into " VerticalAlignment="Center"/>
                    <TextBox x:Name="MirrorHierarchyBox" Text="OpcUaServer" Width="120"/>
                    <Separator/>
                    <Button x:Name="BindButton" Content="Bind to element…" Click="BindButton_Click"
                            ToolTip="Write the selected node's address as NodeId attribute (OPC 10000-83 Annex A) of an element you choose."/>
                    <Separator/>
                    <Button x:Name="SnapshotButton" Content="Read current values" Click="SnapshotButton_Click"
                            ToolTip="Read the value of every bound element and DataVariable of this server into the document."/>
                    <Separator/>
                    <Button x:Name="WatchButton" Content="Watch" Click="WatchButton_Click"
                            ToolTip="Add the selected variable to the live list below (subscription, not written into the document)."/>
                    <Button x:Name="UnwatchButton" Content="Clear watch list" Click="UnwatchButton_Click"/>
                    <Separator/>
                    <Button x:Name="ServeButton" Content="Serve this document" Click="ServeButton_Click"
                            ToolTip="Start a local OPC UA server whose address space is this document's instance hierarchies (a snapshot; restart to update)."/>
                    <TextBlock Text=" port " VerticalAlignment="Center"/>
                    <TextBox x:Name="ServePortBox" Text="48400" Width="50"/>
                </ToolBar>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TreeView x:Name="AddressTree" Grid.Column="0" SelectedItemChanged="AddressTree_SelectedItemChanged"/>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="NodeDetails" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </Grid>
                <StackPanel Grid.Row="3">
                    <ListView x:Name="WatchList" MaxHeight="160" Margin="0,4,0,0" Visibility="Collapsed">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Node" Width="320" DisplayMemberBinding="{Binding Node}"/>
                                <GridViewColumn Header="Value" Width="200" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}"/>
                                <GridViewColumn Header="Received" Width="90" DisplayMemberBinding="{Binding Received}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="ServerStateText" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Diagram" x:Name="DiagramTab">
            <DockPanel Margin="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="DiagramExportButton" DockPanel.Dock="Right" Content="Export SVG…" Width="90" Margin="4,0,0,0" Click="DiagramExportButton_Click"/>
                    <Slider x:Name="DiagramZoom" DockPanel.Dock="Right" Width="110" Minimum="0.3" Maximum="2" Value="1" ValueChanged="DiagramZoom_Changed"
                            ToolTip="Zoom" VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="DiagramShowButton" DockPanel.Dock="Right" Content="Show" Width="70" Click="DiagramShowButton_Click"/>
                    <TextBox x:Name="DiagramDepthBox" DockPanel.Dock="Right" Text="3" Width="30" Margin="4,0" ToolTip="Depth"/>
                    <TextBlock DockPanel.Dock="Right" Text="depth" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="DiagramSourceBox" DockPanel.Dock="Right" Width="320" Margin="4,0" ToolTip="Type or instance to draw"/>
                    <TextBox x:Name="DiagramSearchBox" TextChanged="DiagramSearchBox_TextChanged" ToolTip="Filter types and instances by name"/>
                </DockPanel>
                <TextBlock x:Name="DiagramInfo" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,4,0,0"
                           Text="Pick a UA type or an instance of one; shapes follow OPC 10000-3 (rectangle Object, rounded Variable, ellipse Method, shaded types)."/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                    <Canvas x:Name="DiagramCanvas"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</aml:PluginViewBase>
