<aml:PluginViewBase
    x:Class="Aml.Editor.Plugin.OpcUa.OpcUaPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:aml="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="800">

    <TabControl>
        <TabItem Header="OPC UA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <ToolBar.Resources>
                        <Style x:Key="IconText" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </ToolBar.Resources>

                    <Button x:Name="ImportButton" Click="ImportButton_Click"
                            ToolTip="Import an OPC UA NodeSet (NodeSet2.xml) as AutomationML libraries according to OPC 10000-83 Annex A.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B5;" Foreground="#2070C0"/>
                            <TextBlock Text="Import NodeSet…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FoldersButton" Click="FoldersButton_Click"
                            ToolTip="Folders searched for NodeSets that an import requires. The UA base model and DI are built in.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;"/>
                            <TextBlock Text="NodeSet folders…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <CheckBox x:Name="ReplaceToggle" Content="Replace existing" VerticalAlignment="Center"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTip="Replace OPC UA libraries the document already has. A newer model is never replaced by an older one."/>
                    <CheckBox x:Name="SaveToggle" Content="Save after import" VerticalAlignment="Center" Margin="8,0,0,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTip="Trigger the editor's save command after a successful import."/>
                </ToolBar>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="OPC UA namespaces in this document" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="Placeholder" DockPanel.Dock="Top" Margin="0,8" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Open a CAEX 3.0 document to import OPC UA NodeSets."/>
                        <ListView x:Name="NamespaceList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Namespace URI" Width="360" DisplayMemberBinding="{Binding NamespaceUri}"/>
                                    <GridViewColumn Header="Model version" Width="100" DisplayMemberBinding="{Binding ModelVersion}"/>
                                    <GridViewColumn Header="Published" Width="100" DisplayMemberBinding="{Binding Published}"/>
                                    <GridViewColumn Header="Libraries" Width="70" DisplayMemberBinding="{Binding LibraryCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                    <DockPanel Grid.Row="2" Margin="4">
                        <DockPanel DockPanel.Dock="Top">
                            <CheckBox x:Name="DebugToggle" DockPanel.Dock="Right" Content="Debug log"
                                      Checked="DebugToggle_Changed" Unchecked="DebugToggle_Changed"/>
                            <TextBlock Text="Log" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogFilePathLabel" Margin="8,0" Foreground="Gray"/>
                        </DockPanel>
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Grid>

                <StatusBar Grid.Row="2">
                    <StatusBarItem>
                        <ProgressBar x:Name="Busy" Width="80" Height="12" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusText"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>
    </TabControl>
</aml:PluginViewBase>
