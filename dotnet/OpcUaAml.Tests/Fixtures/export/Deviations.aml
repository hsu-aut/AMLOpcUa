<?xml version="1.0" encoding="utf-8"?>
<!-- Corner cases where the default export deviates from AML-UA-XSLT (docs/export.md, D4 to D12). -->
<CAEXFile SchemaVersion="3.0" FileName="Deviations.aml" xmlns="http://www.dke.de/CAEX">
  <SuperiorStandardVersion>AutomationML 2.10</SuperiorStandardVersion>
  <SuperiorStandardVersion>AutomationML 2.11</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="Tool A" OriginID="A" OriginVersion="1.0" LastWritingDateTime="2026-01-01T00:00:00" />
  <SourceDocumentInformation OriginName="Tool B" OriginID="B" OriginVersion="2.0" LastWritingDateTime="2026-01-02T00:00:00" />
  <InstanceHierarchy Name="Plant">
    <Version>1.0</Version>
    <Copyright>Plant owner</Copyright>
    <InternalElement Name="Pump" ID="11111111-1111-1111-1111-111111111111">
      <Copyright>Pump vendor</Copyright>
      <Attribute Name="Speed" AttributeDataType="xs:double">
        <Value>12.5</Value>
        <RefSemantic CorrespondingAttributePath="ECLASS:0173-1#02-AAA001#001" />
        <RefSemantic CorrespondingAttributePath="IEC61987:ABC123" />
      </Attribute>
      <Attribute Name="Built" AttributeDataType="xs:dateTime">
        <Value>2026-01-01T00:00:00</Value>
      </Attribute>
      <Attribute Name="Price" AttributeDataType="xs:decimal">
        <Value>3.5</Value>
      </Attribute>
      <Attribute Name="Label" AttributeDataType="xs:normalizedString">
        <Value>P-101</Value>
      </Attribute>
      <Attribute Name="Mode" AttributeDataType="xs:string">
        <Constraint Name="Anything">
          <UnknownType>
            <Requirements>free text</Requirements>
          </UnknownType>
        </Constraint>
      </Attribute>
      <ExternalInterface Name="Outlet" ID="22222222-2222-2222-2222-222222222222" RefBaseClassPath="Interfaces/Port" />
      <InternalLink Name="ToNowhere" RefPartnerSideA="11111111-1111-1111-1111-111111111111:Outlet" RefPartnerSideB="33333333-3333-3333-3333-333333333333:Inlet" />
    </InternalElement>
  </InstanceHierarchy>
  <InterfaceClassLib Name="Interfaces">
    <Version>1.0</Version>
    <InterfaceClass Name="Port" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface">
      <InterfaceClass Name="Fluid Port" RefBaseClassPath="Port" />
      <InterfaceClass Name="Hot Port" RefBaseClassPath="Fluid Port" />
    </InterfaceClass>
  </InterfaceClassLib>
  <SystemUnitClassLib Name="Units">
    <SystemUnitClass Name="PumpType" />
  </SystemUnitClassLib>
  <SystemUnitClassLib Name="Units">
    <SystemUnitClass Name="ValveType" />
  </SystemUnitClassLib>
</CAEXFile>
